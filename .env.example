# Telegram Bot Token (от @BotFather)
BOT_TOKEN=replace-with-telegram-bot-token

# Telegram Chat ID администратора для получения алертов
ADMIN_CHAT_ID=

# Пароль отдельного PostgreSQL-сервиса. Используйте длинное случайное значение.
POSTGRES_PASSWORD=replace-with-long-random-password

# Интервал опроса по умолчанию (минут)
DEFAULT_POLL_INTERVAL_MINUTES=15

# Telegram Web App URL (HTTPS)
WEBAPP_URL=https://smattrades.com
API_PORT=8080
API_HOST=0.0.0.0

# Meta OAuth / Marketing API. Секрет и ключ шифрования храните только в .env сервера.
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=https://smattrades.com/api/meta/oauth/callback
# Для ротации: сначала новый ключ, затем старый через запятую.
META_TOKEN_ENCRYPTION_KEY=

# Подписанные данные Telegram Mini App действуют 24 часа
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Необязательное создание первого администратора на чистой установке.
# После первого запуска эти значения можно убрать: существующие пользователи не меняются.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
